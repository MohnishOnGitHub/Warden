# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Model names are never hardcoded. The agent can be a cheap model; the judge decides what runs, so give it a
# stronger one. Check the exact IDs for your key with: python scripts/smoke_gemini.py (set AGENT_MODEL to each).
# Verified IDs on 2026-10-24: gemini-3.5-flash-lite (agent) and gemini-3.8-flash (judge).
AGENT_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.8-flash

# Optional: second model tried when the primary one fails (counts against the 10 s judge budget).
# FALLBACK_MODEL=your-fallback-model-name

# Optional: record or play back every Gemini call (see "Evaluation and replay" in README.md).
# REPLAY_MODE=record
