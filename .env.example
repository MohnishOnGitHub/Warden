# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Model names are never hardcoded. Use the current Gemini Flash model for both.
AGENT_MODEL=your-flash-model-name
JUDGE_MODEL=your-flash-model-name

# Optional: second model tried when the primary one fails (counts against the 10 s judge budget).
# FALLBACK_MODEL=your-fallback-model-name

# Optional: record or play back every Gemini call (see "Evaluation and replay" in README.md).
# REPLAY_MODE=record
